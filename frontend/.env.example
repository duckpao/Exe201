VITE_API_URL=http://localhost:3000
# For Firebase Hosting builds, set this to the deployed backend's public HTTPS origin.
# VITE_API_URL=https://api.example.com
VITE_VIETMAP_TILE_KEY=

# Chưa có Google Client ID — điền sau khi tạo OAuth Client trên Google Cloud Console.
# Khi để trống, nút "Đăng nhập với Google" sẽ tự ẩn/disable.
VITE_GOOGLE_CLIENT_ID=
