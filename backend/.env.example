# Database (khớp với docker-compose.yml / .env ở gốc dự án)
DB_HOST=localhost
DB_PORT=3308
DB_NAME=nhatro
DB_USER=nhatro_user
DB_PASSWORD=nhatro_password

# JWT / cookie session
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
COOKIE_NAME=auth_token

# VietMap Search/Place APIs (giữ key phía backend)
VIETMAP_API_KEY=

# Phí đăng bài và VNPay sandbox. Đăng ký merchant sandbox để nhận TmnCode/HashSecret.
LISTING_FEE_VND=20000
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/api/payments/vnpay/return

# Google OAuth (chưa có Client ID — điền sau khi tạo project trên Google Cloud Console)
GOOGLE_CLIENT_ID=

# SMTP (dùng để gửi email quên mật khẩu thật)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="RentMate Hola <no-reply@rentmatehola.vn>"

# Cloudinary (lưu ảnh/video cho các bài đăng — điền credential thật của bạn vào backend/.env)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend URL (dùng để build link reset password + cors)
FRONTEND_URL=http://localhost:5173

# Thời gian hết hạn token quên mật khẩu (phút)
RESET_TOKEN_EXPIRES_MIN=30
