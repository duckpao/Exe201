# Database (khớp với docker-compose.yml / .env ở gốc dự án)
DB_HOST=localhost
DB_PORT=3308
DB_NAME=nhatro
DB_USER=nhatro_user
DB_PASSWORD=nhatro_password

# Production with Aiven MySQL: set DB_PROVIDER=aiven and provide the AIVEN_* values.
# TLS is enabled automatically for Aiven. Set DB_SSL_CA_PATH to the downloaded Aiven CA
# certificate path when required by your service configuration.
# DB_PROVIDER=aiven
# AIVEN_HOST=your-service.aivencloud.com
# AIVEN_PORT=your-service-port
# AIVEN_USER=avnadmin
# AIVEN_PASSWORD=your-rotated-password
# DB_NAME=defaultdb
# DB_SSL_CA_PATH=./certs/ca.pem

# JWT / cookie session
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
COOKIE_NAME=auth_token

# VietMap Search/Place APIs (giữ key phía backend)
VIETMAP_API_KEY=

# Phí đăng bài và payOS. payOS không có sandbox riêng; giao dịch dev dùng môi trường thật.
LISTING_FEE_VND=20000
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_API_URL=https://api-merchant.payos.vn
PAYOS_RETURN_URL=http://localhost:5173/thanh-toan/dang-bai
PAYOS_CANCEL_URL=http://localhost:5173/thanh-toan/dang-bai?cancel=true
# Webhook phải là URL HTTPS công khai; dùng ngrok/Cloudflare Tunnel khi dev.
PAYOS_WEBHOOK_URL=https://your-public-domain/api/payments/payos/webhook

# Gemini AI chat (giữ API key tuyệt đối ở backend)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Google OAuth (chưa có Client ID — điền sau khi tạo project trên Google Cloud Console)
GOOGLE_CLIENT_ID=

# SMTP (dùng để gửi email quên mật khẩu thật)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="RentMate Hola <no-reply@rentmatehola.vn>"

# Cloudinary (lưu ảnh/video cho các bài đăng — điền credential thật của bạn vào backend/.env)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend URL (một hoặc nhiều origin, phân cách bằng dấu phẩy)
FRONTEND_URL=http://localhost:5173

# Thời gian hết hạn token quên mật khẩu (phút)
RESET_TOKEN_EXPIRES_MIN=30
